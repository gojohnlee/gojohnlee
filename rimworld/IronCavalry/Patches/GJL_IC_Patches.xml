<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- 메카노이드 습격: "전체" 편성과 "근접 전용" 편성에 센티페드 블래스터(10)의 절반 가중치로 추가 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/FactionDef[defName="Mechanoid"]/pawnGroupMakers/li[options/Mech_Apocriton]/options</xpath>
    <value>
      <GJL_IC_IronCavalry>5</GJL_IC_IronCavalry>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/FactionDef[defName="Mechanoid"]/pawnGroupMakers/li[count(options/*)=1 and options/Mech_Scyther]/options</xpath>
    <value>
      <GJL_IC_IronCavalry>5</GJL_IC_IronCavalry>
    </value>
  </Operation>

  <!-- 큰 메카 배양기의 "중량 메카노이드 부활"에 철기병 잔해 추가 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName="ResurrectHeavyMech"]/fixedIngredientFilter/thingDefs</xpath>
    <value>
      <li>Corpse_GJL_IC_IronCavalry</li>
    </value>
  </Operation>

</Patch>

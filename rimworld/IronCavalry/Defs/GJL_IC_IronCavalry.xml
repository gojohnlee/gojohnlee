<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 수치 근거: docs/ironcavalry/spec-v2.txt A2 -->
  <ThingDef ParentName="HeavyMechanoid">
    <defName>GJL_IC_IronCavalry</defName>
    <label>iron cavalry</label>
    <description>A heavy centaur-form assault mechanoid built around a single long lance. It closes distance at speed, and the momentum of its run is delivered into one devastating thrust that can leave the target briefly stunned.</description>
    <statBases>
      <MarketValue>1600</MarketValue>
      <MoveSpeed>4.0</MoveSpeed>
      <ArmorRating_Sharp>0.60</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
      <BandwidthCost>4</BandwidthCost>
      <MechEnergyUsageFactor>1.5</MechEnergyUsageFactor>
    </statBases>
    <tools>
      <!-- untranslatedLabel "lance"로 돌격 첫 공격 동작을 찾는다. 이름을 바꾸면 ChargeUtility.LanceLabel도 바꿀 것 -->
      <li>
        <label>lance</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>36</power>
        <armorPenetration>0.50</armorPenetration>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RightBlade</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
      <li>
        <label>front left hoof</label>
        <labelNoLocation>hoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <armorPenetration>0.25</armorPenetration>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <chanceFactor>0.5</chanceFactor>
      </li>
      <li>
        <label>front right hoof</label>
        <labelNoLocation>hoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <armorPenetration>0.25</armorPenetration>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <chanceFactor>0.5</chanceFactor>
      </li>
    </tools>
    <race>
      <body>GJL_IC_IronCavalry</body>
      <baseBodySize>2.0</baseBodySize>
      <baseHealthScale>3.0</baseHealthScale>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
      <detritusLeavings>
        <li>
          <def>ChunkMechanoidSlag</def>
          <texOverrideIndex>10</texOverrideIndex>
          <spawnChance>0.5</spawnChance>
        </li>
        <li>
          <def>ChunkMechanoidSlag</def>
          <texOverrideIndex>15</texOverrideIndex>
          <spawnChance>0.5</spawnChance>
        </li>
      </detritusLeavings>
    </race>
    <comps>
      <li Class="IronCavalry.CompProperties_IronCavalry" />
    </comps>
  </ThingDef>


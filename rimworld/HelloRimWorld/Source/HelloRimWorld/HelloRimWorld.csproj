<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HelloRimWorld</AssemblyName>
    <RootNamespace>HelloRimWorld</RootNamespace>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 게임 DLL 참조용(컴파일 전용). 게임 버전에 맞춰 올리세요. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <!-- Harmony는 Harmony 모드가 런타임에 제공하므로 DLL을 복사하지 않음 -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
